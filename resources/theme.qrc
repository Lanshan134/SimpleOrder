<!DOCTYPE RCC>
<!-- Combo and spin arrows and the checkbox tick for style.qss. -->
<RCC version="1.0">
    <qresource prefix="/theme">
        <file>check.png</file>
        <file>check@2x.png</file>
        <file>chevron-down.png</file>
        <file>chevron-down@2x.png</file>
        <file>chevron-down-disabled.png</file>
        <file>chevron-down-disabled@2x.png</file>
        <file>chevron-up.png</file>
        <file>chevron-up@2x.png</file>
        <file>chevron-up-disabled.png</file>
        <file>chevron-up-disabled@2x.png</file>
    </qresource>
</RCC>

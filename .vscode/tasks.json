{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译简序",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "build.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "编译并运行简序",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "run.cmd"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["编译简序"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
